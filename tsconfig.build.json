{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "module": "es2022",
    "target": "es2022",
    "skipLibCheck": true,
    "removeComments": false,
    "useDefineForClassFields": false
  },
  "angularCompilerOptions": {
    "compilationMode": "partial"
  },
  "include": [
    "./*.ts"
  ]
}
